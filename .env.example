# Copia este archivo a ".env" y cambia los valores. ".env" NO se sube a GitHub.

# Base de datos (usa una contraseña larga, solo letras y números para evitar problemas en la URL)
POSTGRES_USER=plata
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
POSTGRES_DB=plata_clara

# Clave para firmar las sesiones (JWT). Mínimo 32 caracteres. Genera una con:
#   openssl rand -base64 48
JWT_SECRET=pega-aqui-una-cadena-aleatoria-de-mas-de-32-caracteres

# "production" activa cookies Secure y HSTS (requiere HTTPS).
# Para probar en http://localhost con Docker déjalo en "development".
APP_ENV=development
